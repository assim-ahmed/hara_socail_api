# ملف: backend/.htaccess

RewriteEngine On
RewriteBase /hara_social/backend/

# السماح بطلبات OPTIONS (لـ CORS)
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# إعادة توجيه API routes
RewriteRule ^api/auth$ api/auth.php [L,QSA]
RewriteRule ^api/posts$ api/posts.php [L,QSA]
RewriteRule ^api/friends$ api/friends.php [L,QSA]
RewriteRule ^api/messages$ api/messages.php [L,QSA]

# منع عرض محتويات المجلدات
Options -Indexes

# تعيين الترميز
AddDefaultCharset UTF-8

# منع الوصول المباشر للمجلدات الحساسة
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>